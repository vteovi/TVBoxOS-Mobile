<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 深色模式背景尽量使用纯黑 #000000：OLED 屏幕下像素完全不发光，更省电、更纯粹 -->
    <color name="bg_gray">#000000</color>
    <color name="bg_popup">#000000</color>
    <!-- 窗口/页面底色，浅色下为 #fff，深色下必须覆盖为纯黑，避免跳转/回退时闪白 -->
    <color name="windowBackground">#000000</color>

    <color name="text_foreground">#FFFFFF</color>
    <color name="text_sub_foreground">#AFAFAF</color>

    <!-- 首页顶部数据源切换按钮：深色下用深灰，避免白字落在浅灰底上 -->
    <color name="source_button_bg">#1C1C1C</color>
    <color name="source_button_stroke">#3A3A3A</color>
</resources>